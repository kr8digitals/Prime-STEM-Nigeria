# ==============================================================================
# PRIME STEM NIGERIA — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local (local dev) or configure in Vercel / Hosting Environment
# ==============================================================================

# 1. Public Canonical Site URL
NEXT_PUBLIC_SITE_URL="https://primestemnigeria.afristemglobal.org"

# 2. PostgreSQL / Supabase Database Connection String
# Leave empty during local evaluation to run on the built-in transactional store;
# paste the PostgreSQL URI once the Database Engineer runs 0001_prime_stem_examination_system.sql.
DATABASE_URL=""

# 3. Admin & Exam Session Cryptographic Secrets (Generate strong 32+ byte hex strings in production)
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
EXAM_SESSION_SECRET=""
EXAM_CODE_PEPPER=""

# 4. Resend Email Infrastructure (Free Tier: 3,000 emails/month, 100/day)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Prime STEM Nigeria <exams@primestemnigeria.afristemglobal.org>"
RESEND_REPLY_TO="primestemnigeria@gmail.com"
ADMIN_NOTIFICATION_EMAIL="primestemnigeria@gmail.com"

# 5. Proctoring Recording Vault — Dedicated Google Drive v3 Account (15 GB Free)
# Supports EITHER OAuth2 Refresh Token OR Google Service Account credentials.
# Local development falls back to data/proctoring-vault/; serverless uploads fail without Drive credentials.
# The private folder was created in the connected Drive; runtime credentials must be configured separately.
GOOGLE_DRIVE_FOLDER_ID="1w4Olc_LfV-P5NHSic2o4sMt8pBcYaAFF"

# Option A: OAuth2 Refresh Token for dedicated Google Drive account
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""

# Option B: Google Cloud Service Account with Editor access to GOOGLE_DRIVE_FOLDER_ID
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
